# Build the GKI Image and modules required by strict KMI validation, but skip
# unrelated boot images, certification tools and distribution archives.
MAKE_GOALS="
Image
modules
"

FILES="
arch/arm64/boot/Image
"

SKIP_CP_KERNEL_HDR=1
IN_KERNEL_MODULES=
BUILD_SYSTEM_DLKM=
BUILD_GKI_CERTIFICATION_TOOLS=
BUILD_GKI_ARTIFACTS=
ABI_DEFINITION=
