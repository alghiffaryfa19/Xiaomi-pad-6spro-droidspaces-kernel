# Required and recommended GKI settings from the Droidspaces Chinese guide at
# b9def52e86f70c4c2f63778d71502f0e5fa70885.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Recommended support for nested containers, UFW/Fail2ban and NixOS.
CONFIG_USER_NS=y
# Linux 5.15 uses this IPv4 symbol; NETFILTER_XT_TARGET_REJECT is absent.
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
